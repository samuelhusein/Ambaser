# Copy to .env. Real environment variables override this file.
GATEWAY_PORT=8787
# Required. Every request must send it as the X-Gateway-Token header. The Electron app should generate a random one per launch.
GATEWAY_TOKEN=devtoken123
# Leave empty for direct connections. Credentials are intentionally not supported here; use the mechanism IT approves.
CORPORATE_PROXY=
CORPORATE_PROXY_PORT=
